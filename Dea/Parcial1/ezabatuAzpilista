public class DoubleNode<T> {
 T data;
 DoubleNode<T> next;
 DoubleNode<T> prev;
}
public class DoubleLinkedList<T> {
 DoubleNode<T> first;
 public void ezabatuLista(DoubleLinkedList<T> azpilista){
 // Aurrebaldintza: azpilista uneko listaren zati bat da
 // azpilista zerrendako elementuak ordena berean daude lista nagusian
 // Postbaldintza: azpilista osoa kendu egin da zerrendatik
    if(first==null||azpilista.first==null){
        break;
    }
    boolean amaituta= false;
    DoubleNode aurrekoa= first.prev;
    DoubleNode oraingoa= first;
    DoubleNode azpilistakoAzkena=azpilista.first.prev;
    DoubleNode ezabatuBeharrekoa= azpilista.first;
    while(!amaituta){
        if(ezabatuBeharrekoa== azpilistakoAzkena){
            amaituta= true;
        }
        if (oraingoa.next== oraingoa){
            first=null;
            break;
        }else if(oraingoa.data.equals(ezabatuBeharrekoa.data)){
            DoubleNode hurrengoa = oraingoa.next;
            aurrekoa.next=hurrengoa;
            hurrengoa.prev = aurrekoa;
            if(oraingoa==first){
                first=hurrengoa;
            }
            oraingoa= hurrengoa;
            ezabatuBeharrekoa=ezabatuBeharrekoa.next;
            
        }else{
            aurrekoa=oraingoa;
            oraingoa= oraingoa.next;
        }
    }
 
}
}//Kostua: Tif(k)+Tw(tif·n), beraz, O(n+m)izango da, non n azpilistako nodo kopuruak diren eta m 1. nodoa aurkitu arte lehen zerrendan zeharkatu dena da.(kasu txarrenean kostua lista originalaren luzerak determinatzen du)